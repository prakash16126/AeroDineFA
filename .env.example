# Local demo requires no environment variables.
# Keep all secrets in server/CI secret storage. Never expose a service-role key to Vite.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me-for-server-side-seeding-only
AERODINE_PUBLIC_URL=https://your-deployed-site.example

# Public API base/endpoint URLs only. No secret keys belong in VITE_* variables.
# A configured endpoint must implement the documented request/response contract in README.md.
VITE_API_BASE_URL=
VITE_RESERVATION_API_URL=
VITE_ORDER_API_URL=

# Configure these only in a trusted server/Edge Function environment.
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
